<?xml version="1.0" encoding="utf-8"?>
<!-- Static Wind Spirit mark (was: animated-vector over the upstream mascot).
     The system splash screen shows a static drawable as-is; no animation.
     Art is the 864px full-bleed teal splash PNG so it stays crisp at the
     larger splash icon size. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/ic_launcher_splash_icon"
    android:gravity="center" />
